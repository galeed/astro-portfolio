---
import { SPOTIFY_CONFIG, getSpotifyActivity } from "../config/spotifyConfig";

const liveTrack = await getSpotifyActivity();
const track = liveTrack || {
  isPlaying: false,
  title: "No Active Track",
  artist: "Offline",
  album: "Spotify Inactive",
  albumArt: "",
  songUrl: "https://open.spotify.com",
  progressMs: 0,
  durationMs: 180000,
};

function formatTime(ms: number): string {
  const totalSeconds = Math.floor(ms / 1000);
  const mins = Math.floor(totalSeconds / 60);
  const secs = totalSeconds % 60;
  return `${mins.toString().padStart(2, "0")}:${secs.toString().padStart(2, "0")}`;
}

const isLive = Boolean(liveTrack && liveTrack.isPlaying);
const progressPercent = Math.min(100, Math.max(0, Math.round((track.progressMs / track.durationMs) * 100)));
---

{SPOTIFY_CONFIG.enabled && SPOTIFY_CONFIG.lanyardUserId && SPOTIFY_CONFIG.lanyardUserId.trim() !== "" && (
  <div id="spotify-widget" data-progress={track.progressMs} data-duration={track.durationMs} data-lanyard={SPOTIFY_CONFIG.lanyardUserId || ""} data-is-live={isLive ? "true" : "false"} class="border border-[var(--border-color)] bg-[var(--bg-card)] p-4 font-mono text-xs space-y-3 relative overflow-hidden group hover:border-[var(--accent)] transition-all duration-200">
    <div class="flex items-center justify-between border-b border-[var(--border-color)] pb-2 gap-2">
      <div class="flex items-center gap-1.5 min-w-0">
        <span id="spotify-header-title" class={`${isLive ? "text-emerald-400" : "text-[var(--fg-dim)]"} font-bold flex items-center gap-1.5`}>
          <span class="relative flex h-2 w-2 shrink-0"><span id="spotify-dot-ping" class={`${isLive ? "animate-ping opacity-75" : "hidden"} absolute inline-flex h-full w-full rounded-full bg-emerald-400`}></span><span id="spotify-dot" class={`relative inline-flex rounded-full h-2 w-2 ${isLive ? "bg-emerald-500" : "bg-gray-500"}`}></span></span>
          <span id="spotify-header-text" class="text-[11px] font-bold uppercase tracking-wider">{isLive ? "NOW PLAYING" : "LAST PLAYED"}</span>
        </span>
      </div>
      <span class="uppercase font-bold tracking-widest text-[9px]">RPC</span>
    </div>
    <div class="flex items-center gap-3">
      <div class="w-12 h-12 bg-[var(--bg-main)] border border-[var(--border-color)] relative shrink-0 flex items-center justify-center overflow-hidden">
        <span id="spotify-art-placeholder" class={track.albumArt ? "hidden" : "text-xl"}>📻</span>
        <img id="spotify-art" src={track.albumArt || ""} alt={track.album || "Album Cover"} class={`w-full h-full object-cover transition-all duration-300 ${track.albumArt ? "" : "hidden"}`} />
      </div>
      <div class="flex-1 min-w-0 space-y-0.5">
        <a id="spotify-link" href={track.songUrl || "#"} target="_blank" rel="noopener noreferrer" class="text-[var(--fg-bright)] font-bold text-sm truncate hover:text-[var(--accent)] transition-colors inline-block"><span id="spotify-title">{track.title}</span> ↗</a>
        <div class="text-[var(--fg-main)] text-xs truncate">by <span id="spotify-artist" class="text-[var(--accent)] font-bold">{track.artist}</span></div>
        <div class="text-[var(--fg-dim)] text-[10px] truncate">Album: <span id="spotify-album">{track.album}</span></div>
      </div>
    </div>
    <div class="space-y-1 pt-1"><div class="flex justify-between text-[10px] text-[var(--fg-dim)] font-bold"><span id="spotify-cur-time">▶ {formatTime(track.progressMs)}</span><span id="spotify-pct" class="text-emerald-400">{progressPercent}%</span><span id="spotify-dur-time">{formatTime(track.durationMs)}</span></div><div class="w-full bg-[var(--bg-main)] h-1.5 border border-[var(--border-color)] relative overflow-hidden"><div id="spotify-bar" class="bg-[var(--accent)] h-full transition-all duration-300" style={`width: ${progressPercent}%;`}></div></div></div>
  </div>
)}

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const widget = document.getElementById("spotify-widget");
    if (!widget) return;
    const art = document.getElementById("spotify-art") as HTMLImageElement | null;
    const placeholder = document.getElementById("spotify-art-placeholder");
    art?.addEventListener("error", () => {
      art.classList.add("hidden");
      placeholder?.classList.remove("hidden");
    });
  });
</script>
